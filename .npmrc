# The upstream `deepseek-harness` packages are NOT installed in this subtree:
# the W1 packages compile against transcribed local shims
# (`src/types/shims.d.ts`) so a checkout with zero upstream packages still
# typechecks and still has executable tests. pnpm 8 auto-installs peers by
# default, which would silently pull the real (and differently versioned)
# upstream packages in and quietly replace the shims — the exact drift this
# subtree is set up to make visible.
auto-install-peers=false
