{
  "name": "@dsh-studio/studio-surface",
  "description": "DSH Studio host half: owns the surface manifest and serves the 127.0.0.1 data channel (throwaway scaffolding, removed in W8)",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "bundle": "tsc -p tsconfig.build.json && tsdown",
    "watch": "tsc -p tsconfig.build.json && tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-apiproxy": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-app-boot": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "@dsh-studio/studio-client": "workspace:*"
  }
}
